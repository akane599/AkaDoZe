<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/coordinatorLayout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScrollTargetViewId="@id/mainScrollView">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable so the access card (added later, at the top of mainContent) never pushes
         the service switch off-screen in landscape or at large font scales. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Left-aligned and asymmetric: every block keeps a wider end margin than its start margin. -->
        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_6"
            tools:context="com.akylas.enforcedoze.MainActivity">

            <!-- Inner padding is space_3 so the nested debt card's corner_inner = corner_card - space_3. -->
            <com.akylas.enforcedoze.ui.amber.AmberCardView
                android:id="@+id/accessCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_3"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingTop="@dimen/space_4"
                    android:paddingBottom="@dimen/space_3">

                    <TextView
                        android:id="@+id/accessCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:text="@string/access_card_title"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/accessModeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:layout_marginTop="@dimen/space_2"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Mode: Shizuku (shell)" />

                    <!-- Live region: access changes (Shizuku stopped, root granted) are announced. -->
                    <TextView
                        android:id="@+id/accessStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:layout_marginTop="@dimen/space_1"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/access_status_checking"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/accessProblemsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:layout_marginTop="@dimen/space_2"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="• Motion sensor restriction: Shizuku isn't running"
                        tools:visibility="visible" />

                    <com.akylas.enforcedoze.ui.amber.AmberCardView
                        android:id="@+id/accessDebtCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:visibility="gone"
                        app:cardCornerRadius="@dimen/corner_inner"
                        app:cardBackgroundColor="?attr/colorErrorContainer"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/space_3"
                            android:paddingEnd="@dimen/space_2"
                            android:paddingTop="@dimen/space_3"
                            android:paddingBottom="@dimen/space_1">

                            <TextView
                                android:id="@+id/accessDebtText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAlignment="viewStart"
                                android:layout_marginEnd="@dimen/space_2"
                                android:accessibilityLiveRegion="polite"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnErrorContainer"
                                tools:text="@string/access_debt_access_lost" />

                            <com.akylas.enforcedoze.ui.amber.AmberButton
                                android:id="@+id/accessRestoreButton"
                                style="@style/Widget.Amber.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:layout_marginTop="@dimen/space_1"
                                android:contentDescription="@string/access_restore_description"
                                android:text="@string/access_restore_now"
                                android:textColor="?attr/colorOnErrorContainer" />

                            <com.akylas.enforcedoze.ui.amber.AmberButton
                                android:id="@+id/accessDismissButton"
                                style="@style/Widget.Amber.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:contentDescription="@string/damaged_records_dismiss_description"
                                android:text="@string/damaged_records_dismiss"
                                android:textColor="?attr/colorOnErrorContainer"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.akylas.enforcedoze.ui.amber.AmberCardView>

                    <com.akylas.enforcedoze.ui.amber.AmberButton
                        android:id="@+id/accessActionButton"
                        style="@style/Widget.Amber.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/access_action_grant_helpers" />
                </LinearLayout>
            </com.akylas.enforcedoze.ui.amber.AmberCardView>

            <!-- The hero: the service state in serif, left-aligned with a wide end margin. Glows while on. -->
            <com.akylas.enforcedoze.ui.amber.AmberCardView
                android:id="@+id/serviceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingTop="@dimen/space_5"
                    android:paddingBottom="@dimen/space_4">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:textAlignment="viewStart"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:text="@string/service_inactive" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/switch1"
                        android:layout_gravity="start"
                        android:layout_marginTop="@dimen/space_4"
                        android:contentDescription="@string/main_service_switch_description" />
                </LinearLayout>
            </com.akylas.enforcedoze.ui.amber.AmberCardView>

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginStart="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_5"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:text="@string/force_doze_info"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
