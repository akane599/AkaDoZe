<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AboutAppActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_3">

            <!-- App header card: serif name, tabular version. -->
            <com.akylas.enforcedoze.ui.amber.AmberCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/space_5">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="@string/app_name" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/app_name"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/textVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="1.11.0 (build 87)" />

                </LinearLayout>
            </com.akylas.enforcedoze.ui.amber.AmberCardView>

            <!-- Sponsor card: the one accent-tinted surface on this screen. -->
            <com.akylas.enforcedoze.ui.amber.AmberCardView
                android:id="@+id/sponsorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                app:cardBackgroundColor="?attr/colorPrimaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_2">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sponsor_card_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_heart"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sponsor_card_text"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:layout_marginBottom="@dimen/space_3" />

                    <!-- Stacked full width at every font scale: side by side, labels
                         break mid-word at 2.0 on a 360dp screen (280dp content). -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.akylas.enforcedoze.ui.amber.AmberButton
                            android:id="@+id/btnGithubSponsors"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_2"
                            android:text="@string/sponsor_github"
                            android:onClick="openGithubSponsors" />

                        <com.akylas.enforcedoze.ui.amber.AmberButton
                            android:id="@+id/btnLiberapay"
                            style="@style/Widget.Amber.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sponsor_liberapay"
                            android:onClick="openLiberapay" />

                    </LinearLayout>

                </LinearLayout>
            </com.akylas.enforcedoze.ui.amber.AmberCardView>

            <!-- Open source card -->
            <com.akylas.enforcedoze.ui.amber.AmberCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_open_source_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_2" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_app_opensrc_text"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="@dimen/space_2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.akylas.enforcedoze.ui.amber.AmberButton
                            android:id="@+id/btnLicenses"
                            style="@style/Widget.Amber.Button.Text"
                            android:layout_width="match_parent"
                            android:gravity="start|center_vertical"
                            android:layout_height="wrap_content"
                            android:text="@string/licenses"
                            android:onClick="showLicences" />

                        <com.akylas.enforcedoze.ui.amber.AmberButton
                            android:id="@+id/btnSourceCode"
                            style="@style/Widget.Amber.Button.Text"
                            android:layout_width="match_parent"
                            android:gravity="start|center_vertical"
                            android:layout_height="wrap_content"
                            android:text="@string/source_code"
                            android:onClick="openSourceCode" />

                    </LinearLayout>

                </LinearLayout>
            </com.akylas.enforcedoze.ui.amber.AmberCardView>

            <!-- Info & legal card -->
            <com.akylas.enforcedoze.ui.amber.AmberCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_info_legal_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/space_2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.akylas.enforcedoze.ui.amber.AmberButton
                            android:id="@+id/btnTranslations"
                            style="@style/Widget.Amber.Button.Text"
                            android:layout_width="match_parent"
                            android:gravity="start|center_vertical"
                            android:layout_height="wrap_content"
                            android:text="@string/translations"
                            android:onClick="showTranslationCreditsDialog" />

                        <com.akylas.enforcedoze.ui.amber.AmberButton
                            android:id="@+id/btnPrivacyPolicy"
                            style="@style/Widget.Amber.Button.Text"
                            android:layout_width="match_parent"
                            android:gravity="start|center_vertical"
                            android:layout_height="wrap_content"
                            android:text="@string/privacy_policy"
                            android:onClick="showPrivacyPolicy" />

                    </LinearLayout>

                </LinearLayout>
            </com.akylas.enforcedoze.ui.amber.AmberCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
