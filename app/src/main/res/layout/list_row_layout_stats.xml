<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_2"
    android:paddingEnd="@dimen/space_2"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_2"
    android:gravity="center_vertical">

    <!-- Doze transition and its time: tabular figures so the timestamps line up row to row. -->
    <TextView
        android:id="@+id/dozeStateTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.Amber.BodyMedium.Numeric"
        android:textColor="?attr/colorOnSurface"
        tools:text="Entered Doze mode at 23:10:42" />

    <!-- Battery level is data: sage, tabular. -->
    <TextView
        android:id="@+id/batteryLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginTop="@dimen/space_1"
        android:textAppearance="@style/TextAppearance.Amber.LabelLarge.Numeric"
        android:textColor="?attr/colorSecondary"
        tools:text="Battery level: 87%" />

</LinearLayout>
