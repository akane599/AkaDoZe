<?xml version="1.0" encoding="utf-8"?>
<com.akylas.enforcedoze.ui.amber.AmberCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_1"
    android:layout_marginBottom="@dimen/space_1"
    app:cardBackgroundColor="?attr/colorTertiaryContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_3">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/space_3"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_monitor_info"
            app:tint="?attr/colorOnTertiaryContainer" />

        <TextView
            android:id="@+id/bannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnTertiaryContainer"
            tools:text="@string/monitor_banner_partial" />
    </LinearLayout>
</com.akylas.enforcedoze.ui.amber.AmberCardView>
