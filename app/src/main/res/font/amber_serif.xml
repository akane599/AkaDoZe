<?xml version="1.0" encoding="utf-8"?>
<!--
  Source Serif 4 (variable, OFL; licence in assets/licenses/OFL-SourceSerif4.txt). Used only at display,
  headline and titleLarge sizes (21.9-42.7sp), so the optical size axis is pinned to 32 (display cut).
  Instances on API 26+: 500 regular, 650 bold. API 23-25 render the file's default instance. Source Serif 4 has
  no tnum, so numbers always use amber_sans.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/source_serif_4_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 500, 'opsz' 32"
        android:fontWeight="400"
        app:font="@font/source_serif_4_variable"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 500, 'opsz' 32"
        app:fontWeight="400" />
    <font
        android:font="@font/source_serif_4_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 650, 'opsz' 32"
        android:fontWeight="700"
        app:font="@font/source_serif_4_variable"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 650, 'opsz' 32"
        app:fontWeight="700" />
</font-family>
