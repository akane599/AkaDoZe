<?xml version="1.0" encoding="utf-8"?>
<!-- One broadcast per card. The adapter forwards card clicks to the list's item click (copy to clipboard),
     so the ripple follows the squircle instead of the list's rectangular selector. -->
<com.akylas.enforcedoze.ui.amber.AmberCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <TextView
            android:id="@+id/broadcastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hyphenationFrequency="none"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="com.akylas.enforcedoze.ENABLE_FORCEDOZE" />

        <TextView
            android:id="@+id/broadcastValues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="@string/tasker_no_values" />
    </LinearLayout>
</com.akylas.enforcedoze.ui.amber.AmberCardView>
