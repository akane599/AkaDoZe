<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Start padding matches the dialog's 24dp title/message inset; the icon buttons carry their own padding. -->
    <!-- Commands are not selectable: AccessUi shows them through BroadcastNameBreaks so they wrap at . and _,
         and Android does not map selection offsets across a length-changing transformation. The copy and
         share buttons carry the exact command. -->
    <!-- The message lives here, not in setMessage(): the dialog's own message panel and this view would share
         its height unweighted, and at large font scales the message took all of it, buttons included. In one
         ScrollView, AlertDialogLayout keeps the buttons and scrolls message and commands together. -->
    <!-- paddingTop stands in for the 16dp title-to-message spacer the dialog shows only with setMessage(). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_3"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_2">

        <!-- Looks like the dialog message (M3 supporting text); paddingEnd tops the 8dp up to its 24dp inset. -->
        <TextView
            android:id="@+id/adbInstructionsMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/space_3"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="@string/no_root_workaround_dialog_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_3"
            >

            <TextView
                android:id="@+id/commandTxt1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:text="adb -d shell pm grant com.akylas.enforcedoze android.permission.DUMP"
                android:layout_gravity="center_vertical" />


            <com.akylas.enforcedoze.ui.amber.AmberButton
                style="@style/Widget.Amber.Button.Icon.Neutral"
                android:id="@+id/shareBtn1"
                android:contentDescription="@string/amber_SQ42_share_command"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/share_variant"
                android:layout_gravity="center_vertical" />

            <com.akylas.enforcedoze.ui.amber.AmberButton
                style="@style/Widget.Amber.Button.Icon.Neutral"
                android:id="@+id/copyBtn1"
                android:contentDescription="@string/copy_to_clipboard_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/content_copy"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_3"
            >

            <TextView
                android:id="@+id/commandTxt2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:text="adb -d shell pm grant com.akylas.enforcedoze android.permission.WRITE_SECURE_SETTINGS"
                android:layout_gravity="center_vertical" />


            <com.akylas.enforcedoze.ui.amber.AmberButton
                style="@style/Widget.Amber.Button.Icon.Neutral"
                android:id="@+id/shareBtn2"
                android:contentDescription="@string/amber_SQ42_share_command"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/share_variant"
                android:layout_gravity="center_vertical" />

            <com.akylas.enforcedoze.ui.amber.AmberButton
                style="@style/Widget.Amber.Button.Icon.Neutral"
                android:id="@+id/copyBtn2"
                android:contentDescription="@string/copy_to_clipboard_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/content_copy"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
