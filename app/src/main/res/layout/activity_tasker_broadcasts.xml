<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TaskerBroadcastsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Padding lives on the list (clipToPadding=false) so cards scroll under the navigation bar.
         The transparent divider is only the space_2 gap between cards; cards draw their own pressed ripple. -->
    <ListView
        android:id="@+id/listViewBroadcasts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/space_2"
        android:listSelector="@android:color/transparent"
        android:nestedScrollingEnabled="true"
        android:scrollbarStyle="outsideOverlay"
        android:paddingBottom="@dimen/space_3"
        android:paddingLeft="@dimen/space_3"
        android:paddingRight="@dimen/space_3"
        android:paddingTop="@dimen/space_2"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
