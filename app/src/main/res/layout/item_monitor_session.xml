<?xml version="1.0" encoding="utf-8"?>
<com.akylas.enforcedoze.ui.amber.AmberCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sessionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_1"
    android:layout_marginBottom="@dimen/space_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <!-- Date, time and duration: tabular figures so the session list lines up. -->
        <TextView
            android:id="@+id/sessionDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Tue 3 Oct, 23:10 · 7h02" />

        <TextView
            android:id="@+id/sessionCoverage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Deep 94% · Light 3% · Unknown 3%" />

        <TextView
            android:id="@+id/sessionCounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="2 maintenance · 0 re-forces · Sensors off ✓ · 0.9%/h" />

        <TextView
            android:id="@+id/sessionExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="First verified deep Doze after 4 min"
            tools:visibility="visible" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sessionProblems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:importantForAccessibility="noHideDescendants"
            android:visibility="gone"
            app:chipSpacingHorizontal="@dimen/space_2"
            app:chipSpacingVertical="@dimen/space_1"
            tools:visibility="visible" />
    </LinearLayout>
</com.akylas.enforcedoze.ui.amber.AmberCardView>
