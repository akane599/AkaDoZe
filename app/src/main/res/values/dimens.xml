<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>

    <!-- Amber Night spacing scale. -->
    <dimen name="space_1">4dp</dimen>
    <dimen name="space_2">8dp</dimen>
    <dimen name="space_3">16dp</dimen>
    <dimen name="space_4">24dp</dimen>
    <dimen name="space_5">32dp</dimen>
    <dimen name="space_6">48dp</dimen>

    <!-- Corners. Nested corners follow inner = outer - padding. -->
    <dimen name="corner_card">24dp</dimen>
    <dimen name="corner_button">16dp</dimen>
    <dimen name="corner_inner">8dp</dimen>

    <!-- Elevation only for the active element's glow; everything else stays at 0. -->
    <dimen name="glow_elevation">6dp</dimen>
    <dimen name="hairline">1dp</dimen>
</resources>
