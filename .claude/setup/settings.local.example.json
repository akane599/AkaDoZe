{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git remote -v:*)",
      "Bash(bash .claude/kit/detect-stack.sh:*)",
      "Bash(python3 .claude/kit/scaffold.py:*)"
    ]
  },
  "enabledPlugins": {
    "kotlin-lsp-android@android-local": true,
    "android-kmp-playbook@android-local": true,
    "droidforge@android-local": true
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:18764",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5[1m]",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1[1m]"
  }
}
