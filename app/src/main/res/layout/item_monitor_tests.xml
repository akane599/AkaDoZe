<?xml version="1.0" encoding="utf-8"?>
<com.akylas.enforcedoze.ui.amber.AmberCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_2"
    android:layout_marginBottom="@dimen/space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <TextView
            android:id="@+id/testsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:text="@string/monitor_tests_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/monitor_tests_intro"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Tonal, not filled: the tests are secondary to the live state above. -->
        <com.akylas.enforcedoze.ui.amber.AmberButton
            android:id="@+id/testDoze"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/monitor_test_doze"
            app:shapeAppearance="@style/ShapeAppearance.Amber.Medium" />

        <TextView
            android:id="@+id/testDozeUnavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Test Doze now: Needs Shizuku access"
            tools:visibility="visible" />

        <com.akylas.enforcedoze.ui.amber.AmberButton
            android:id="@+id/testSensors"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/monitor_test_sensors"
            app:shapeAppearance="@style/ShapeAppearance.Amber.Medium" />

        <TextView
            android:id="@+id/testSensorsUnavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/testProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Status and results are announced politely when a test starts and finishes. -->
        <TextView
            android:id="@+id/testStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:layout_marginTop="@dimen/space_1"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/testResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/testResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Test Doze now — Passed" />

            <TextView
                android:id="@+id/testResultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="@string/monitor_result_doze_passed" />

            <com.akylas.enforcedoze.ui.amber.AmberButton
                android:id="@+id/testRawToggle"
                style="@style/Widget.Amber.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:text="@string/monitor_test_raw_show" />

            <HorizontalScrollView
                android:id="@+id/testRawScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainerHighest"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/testRaw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="@dimen/space_2"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    tools:text="$ cmd deviceidle force-idle deep\nexit 0\nNow forced in to deep idle mode" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</com.akylas.enforcedoze.ui.amber.AmberCardView>
