    <!--
      Material 1.12's dark theme gives android:textColorPrimary/Secondary/Hint/Highlight fixed selectors
      (m3_dark_default_color_*_text, m3_dark_hint_foreground, ...) built on these library colors, not on
      ?attr/colorOnSurface. Overriding the base colors makes plain TextViews use the warm text tokens while the
      selectors keep their disabled-state alpha.
    -->
    <color name="m3_sys_color_dark_on_surface" tools:override="true">@color/amber_on_surface</color>
    <color name="m3_sys_color_dark_on_surface_variant" tools:override="true">@color/amber_on_surface_variant</color>
    <color name="m3_sys_color_dark_on_background" tools:override="true">@color/amber_on_surface</color>
    <color name="m3_sys_color_dark_primary" tools:override="true">@color/amber_primary_day</color>
</resources>
