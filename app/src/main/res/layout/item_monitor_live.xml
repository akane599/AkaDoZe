<?xml version="1.0" encoding="utf-8"?>
<!-- The live card is the screen's one amber element: duotone icon while deep Doze is idle, glow while forced
     (MonitorAdapter.accentLive). -->
<com.akylas.enforcedoze.ui.amber.AmberCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_2"
    android:layout_marginBottom="@dimen/space_2"
    app:cardBackgroundColor="?attr/colorSurfaceContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/liveIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/space_3"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_monitor_idle" />

            <TextView
                android:id="@+id/liveTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/monitor_live_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <com.akylas.enforcedoze.ui.amber.AmberButton
                android:id="@+id/liveRefresh"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/monitor_refresh"
                android:tooltipText="@string/monitor_refresh"
                app:icon="@drawable/ic_monitor_refresh"
                tools:targetApi="o" />
        </LinearLayout>

        <!-- One line per value: wraps cleanly at large font scales; read in order by TalkBack. -->
        <TextView
            android:id="@+id/liveAccess"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            tools:text="Access: Shizuku (shell)" />

        <TextView
            android:id="@+id/liveUnavailable"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="Doze state can't be read: Needs DUMP permission"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/liveDeep"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textColor="?attr/colorOnSurface"
            tools:text="Deep Doze: Active" />

        <TextView
            android:id="@+id/liveLight"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            tools:text="Light Doze: Active" />

        <TextView
            android:id="@+id/liveForced"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            tools:text="Forced idle: No" />

        <TextView
            android:id="@+id/liveQuick"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            tools:text="Quick Doze: No" />

        <TextView
            android:id="@+id/liveSensors"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            tools:text="Motion sensors: Normal (not restricted)" />

        <TextView
            android:id="@+id/liveWatchdog"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            tools:text="Keep Doze enforced: On" />

        <TextView
            android:id="@+id/liveDebtNone"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monitor_live_debt_none"
            android:textColor="?attr/colorOnSurface" />

        <!-- Nested in the 16dp-padded live card: inner radius = 24dp - 16dp = corner_inner. -->
        <com.akylas.enforcedoze.ui.amber.AmberCardView
            android:id="@+id/liveDebtCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorErrorContainer"
            app:cardCornerRadius="@dimen/corner_inner"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <TextView
                    android:id="@+id/liveDebtText"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="?attr/colorOnErrorContainer"
                    tools:text="@string/access_debt_generic" />

                <com.akylas.enforcedoze.ui.amber.AmberButton
                    android:id="@+id/liveDismiss"
                    style="@style/Widget.Amber.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_1"
                    android:contentDescription="@string/damaged_records_dismiss_description"
                    android:text="@string/damaged_records_dismiss"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:visibility="gone" />
            </LinearLayout>
        </com.akylas.enforcedoze.ui.amber.AmberCardView>

        <TextView
            android:id="@+id/liveUpdated"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:accessibilityLiveRegion="polite"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Read at 22:14:03" />

        <!-- Buttons wrap their label instead of clipping at large font scales. Restore is the quiet text action,
             Share the outlined one; no filled button competes with the live state. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="end"
            android:orientation="horizontal">

            <com.akylas.enforcedoze.ui.amber.AmberButton
                android:id="@+id/liveRestore"
                style="@style/Widget.Amber.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:layout_weight="1"
                android:contentDescription="@string/monitor_restore_system_description"
                android:maxLines="3"
                android:text="@string/monitor_restore_system" />

            <com.akylas.enforcedoze.ui.amber.AmberButton
                android:id="@+id/liveShare"
                style="@style/Widget.Amber.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="3"
                android:text="@string/monitor_share_report"
                app:icon="@drawable/share_variant" />
        </LinearLayout>
    </LinearLayout>
</com.akylas.enforcedoze.ui.amber.AmberCardView>
